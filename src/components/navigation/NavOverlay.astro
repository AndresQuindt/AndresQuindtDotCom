---
import type { Language, SectionProps } from "@/config/pages/types";
import type { UITranslations } from "@/i18n/types";

interface Props extends SectionProps<UITranslations> {
    lang: Language;
}

const { translations, lang } = Astro.props;
---

<nav
    id="nav-overlay"
    class="fixed inset-0 z-50 bg-zinc-950/90 backdrop-blur-2xl flex items-center md:items-center justify-center md:justify-center opacity-0 invisible transition-all duration-500"
>
    <div
        class="w-full px-6 pb-32 md:pb-0 flex flex-col items-end md:items-center gap-8"
    >
        <ul class="flex flex-col items-end md:items-center gap-6 md:gap-8">
            <li
                class="nav-item opacity-0 translate-y-8"
                style="transition-delay: 0ms;"
            >
                <a
                    href="#hero"
                    class="nav-link text-5xl md:text-6xl font-black uppercase tracking-tighter text-zinc-400 hover:text-amber-600 transition-all duration-300"
                >
                    {translations.menu.home}
                </a>
            </li>
            <li
                class="nav-item opacity-0 translate-y-8"
                style="transition-delay: 100ms;"
            >
                <a
                    href="#about"
                    class="nav-link text-5xl md:text-6xl font-black uppercase tracking-tighter text-zinc-400 hover:text-amber-600 transition-all duration-300"
                >
                    {translations.menu.about}
                </a>
            </li>
            <li
                class="nav-item opacity-0 translate-y-8"
                style="transition-delay: 200ms;"
            >
                <a
                    href="#skills"
                    class="nav-link text-5xl md:text-6xl font-black uppercase tracking-tighter text-zinc-400 hover:text-amber-600 transition-all duration-300"
                >
                    {translations.menu.skills}
                </a>
            </li>
            <li
                class="nav-item opacity-0 translate-y-8"
                style="transition-delay: 300ms;"
            >
                <a
                    href="#experience"
                    class="nav-link text-5xl md:text-6xl font-black uppercase tracking-tighter text-zinc-400 hover:text-amber-600 transition-all duration-300"
                >
                    {translations.menu.experience}
                </a>
            </li>
        </ul>

        <div
            class="nav-item opacity-0 translate-y-8 flex items-center gap-2 font-mono text-sm mt-4"
            style="transition-delay: 400ms;"
        >
            <a
                href="/"
                class={`transition-colors duration-200 ${lang === "es" ? "text-amber-600 font-bold" : "text-zinc-500 hover:text-zinc-300"}`}
                aria-label="Español"
            >
                ES
            </a>
            <span class="text-zinc-700">/</span>
            <a
                href="/en"
                class={`transition-colors duration-200 ${lang === "en" ? "text-amber-600 font-bold" : "text-zinc-500 hover:text-zinc-300"}`}
                aria-label="English"
            >
                EN
            </a>
        </div>
    </div>
</nav>

<style>
    .nav-item {
        transition:
            opacity 0.5s ease,
            transform 0.5s ease;
    }

    .nav-link {
        position: relative;
        display: inline-block;
    }

    #nav-overlay {
        user-select: none;
    }
</style>
