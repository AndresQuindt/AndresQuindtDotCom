---

<button
    id="menu-toggle"
    class="fixed bottom-6 right-6 md:top-6 md:bottom-auto z-[60] w-14 h-14 md:w-12 md:h-12 backdrop-blur-sm border border-zinc-800/50 md:border-0 flex flex-col items-center justify-center gap-1.5 hover:border-amber-600/70 md:hover:border-0 hover:backdrop-blur-md transition-all duration-300"
    aria-label="Toggle Navigation Menu"
>
    <span class="menu-line w-5 h-[2px] bg-zinc-400 transition-all duration-300"
    ></span>
    <span class="menu-line w-3 h-[2px] bg-zinc-400 transition-all duration-300"
    ></span>
    <span class="menu-line w-5 h-[2px] bg-zinc-400 transition-all duration-300"
    ></span>
</button>

<script>
    const menuToggle = document.getElementById(
        "menu-toggle",
    ) as HTMLButtonElement | null;
    const navOverlay = document.getElementById(
        "nav-overlay",
    ) as HTMLElement | null;
    const navItems = document.querySelectorAll<HTMLElement>(".nav-item");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const menuLines = document.querySelectorAll<HTMLElement>(".menu-line");
    const body = document.body;

    let isMenuOpen = false;

    function toggleMenu() {
        if (!navOverlay) return;

        isMenuOpen = !isMenuOpen;

        if (isMenuOpen) {
            navOverlay.classList.remove("opacity-0", "invisible");
            navOverlay.classList.add("opacity-100", "visible");
            body.style.overflow = "hidden";

            (menuLines[0] as HTMLElement).style.transform =
                "rotate(45deg) translateY(6px)";
            (menuLines[1] as HTMLElement).style.opacity = "0";
            (menuLines[2] as HTMLElement).style.transform =
                "rotate(-45deg) translateY(-6px)";

            navItems.forEach((item, index) => {
                setTimeout(() => {
                    item.style.opacity = "1";
                    item.style.transform = "translateY(0)";
                    item.style.transition =
                        "opacity 0.5s ease, transform 0.5s ease";
                }, index * 100);
            });
        } else {
            navOverlay.classList.remove("opacity-100", "visible");
            navOverlay.classList.add("opacity-0", "invisible");
            body.style.overflow = "";

            (menuLines[0] as HTMLElement).style.transform = "";
            (menuLines[1] as HTMLElement).style.opacity = "1";
            (menuLines[2] as HTMLElement).style.transform = "";

            navItems.forEach((item) => {
                item.style.opacity = "0";
                item.style.transform = "translateY(2rem)";
            });
        }
    }

    if (menuToggle) {
        menuToggle.addEventListener("click", toggleMenu);
    }

    navLinks.forEach((link) => {
        link.addEventListener("click", () => {
            toggleMenu();
        });
    });

    navLinks.forEach((link) => {
        link.addEventListener("mouseenter", () => {
            navLinks.forEach((otherLink) => {
                if (otherLink !== link) {
                    otherLink.style.opacity = "0.2";
                    otherLink.style.transform = "translateX(0)";
                } else {
                    otherLink.style.transform = "translateX(1rem)";
                }
            });
        });

        link.addEventListener("mouseleave", () => {
            navLinks.forEach((otherLink) => {
                otherLink.style.opacity = "1";
                otherLink.style.transform = "translateX(0)";
            });
        });
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isMenuOpen) {
            toggleMenu();
        }
    });
</script>

<style>
    .menu-line {
        transform-origin: center;
    }
</style>
