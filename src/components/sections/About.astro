---
import miFoto from "@/assets/profile-andres-quindt.jpg";
import type { SectionProps } from "@/config/pages/types";
import type { AboutTranslations } from "@/i18n/types";
import { Image } from "astro:assets";

interface Props extends SectionProps<AboutTranslations> {}

const { translations } = Astro.props;
---

<section id="about" class="border-t border-zinc-800 px-6 py-16 md:py-32">
    <div class="max-w-6xl mx-auto">
        <div
            class="observe-fade grid md:grid-cols-12 gap-8 md:gap-16 items-center"
        >
            <div class="md:col-span-5">
                <div class="relative">
                    <div class="absolute -inset-4 bg-amber-600/5 blur-2xl">
                    </div>
                    <Image
                        src={miFoto}
                        alt="Andrés Quindt - Software Engineering Lead"
                        width={400}
                        height={400}
                        class="relative border border-zinc-800 grayscale hover:grayscale-0 transition-all duration-500"
                    />
                </div>
            </div>
            <div class="md:col-span-7">
                <span
                    class="font-mono text-xs text-amber-600 tracking-wider uppercase mb-4 block"
                >
                    {translations.label}
                </span>
                <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">
                    {translations.title}
                </h2>
                <p
                    class="text-lg md:text-xl text-zinc-300 leading-relaxed mb-6"
                >
                    {translations.p1}
                </p>
                <p class="text-base text-zinc-400 leading-relaxed">
                    {translations.p2}
                </p>
            </div>
        </div>
    </div>
</section>
