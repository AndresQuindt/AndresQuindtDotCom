---
import type { SectionProps } from "@/config/pages/types";
import type { FooterTranslations } from "@/i18n/types";

interface Props extends SectionProps<FooterTranslations> {}

const { translations } = Astro.props;
---

<footer class="border-t border-zinc-800 px-6 py-12 md:py-16">
    <div class="max-w-6xl mx-auto">
        <div
            class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-12 mb-12"
        >
            <div>
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-2">
                    {translations.name}
                </h2>
                <p
                    class="text-base text-zinc-400 leading-relaxed max-w-sm"
                    set:html={translations.subtitle}
                />
            </div>

            <div class="flex flex-col items-start lg:items-end gap-3 text-base">
                <a
                    href={`mailto:${translations.email}`}
                    class="text-zinc-300 hover:text-amber-600 transition-colors duration-200"
                >
                    {translations.email}
                </a>
                <a
                    href="https://linkedin.com/in/andresquindt"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-zinc-300 hover:text-amber-600 transition-colors duration-200 flex items-center gap-2 group"
                >
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                        ></path>
                    </svg>
                    <span>{translations.linkedin}</span>
                </a>
                <p class="text-zinc-400">{translations.location}</p>
            </div>
        </div>

        <div
            class="flex flex-col md:flex-row md:items-center md:justify-between gap-6"
        >
            <p class="font-mono text-xs text-zinc-600 opacity-40">
                {translations.builtWith}
            </p>
        </div>
    </div>
</footer>
