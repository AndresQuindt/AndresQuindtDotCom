---
import type { SectionProps } from "@/config/pages/types";
import type { HeroTranslations } from "@/i18n/types";

interface Props extends SectionProps<HeroTranslations> {}

const { translations } = Astro.props;
---

<section
    id="hero"
    class="min-h-screen flex items-center justify-center px-6 py-12 md:py-16"
>
    <div class="max-w-6xl w-full">
        <div class="observe-fade">
            <h1
                class="text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight mb-6"
            >
                ANDRÉS QUINDT
            </h1>
            <h2
                class="text-xl sm:text-2xl md:text-3xl text-zinc-400 font-medium mb-8"
            >
                {translations.title}
            </h2>
            <p
                class="text-base md:text-lg text-zinc-400 max-w-3xl mb-6 leading-relaxed"
            >
                {translations.description}
            </p>
        </div>
    </div>
</section>
