---
import type { SectionProps } from "@/config/pages/types";
import type { ExperienceTranslations } from "@/i18n/types";

interface Props extends SectionProps<ExperienceTranslations> {}

const { translations } = Astro.props;
---

<section id="experience" class="border-t border-zinc-800 px-6 py-16 md:py-32">
    <div class="max-w-6xl mx-auto">
        <div class="observe-fade mb-8 md:mb-16">
            <span
                class="font-mono text-xs text-amber-600 tracking-wider uppercase mb-4 block"
            >
                {translations.label}
            </span>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight">
                {translations.title}
            </h2>
        </div>

        <div class="relative md:pl-12 space-y-8 md:space-y-16">
            <div
                class="hidden md:block absolute left-0 top-0 bottom-0 w-0.5 bg-gradient-to-b from-zinc-700 via-zinc-800 to-transparent"
            >
            </div>

            <!-- Current Position -->
            <article class="observe-fade relative">
                <div
                    class="border border-zinc-700 bg-gradient-to-br from-zinc-900 to-zinc-900/50 p-5 md:p-8 relative overflow-hidden hover:shadow-2xl hover:shadow-amber-600/20 transition-all duration-300"
                >
                    <div
                        class="absolute top-0 right-0 w-64 h-64 bg-amber-600/5 blur-3xl"
                    >
                    </div>

                    <div class="inline-block mb-4 md:mb-6">
                        <span
                            class="inline-flex items-center gap-1.5 bg-amber-600/10 border border-amber-600/30 text-amber-600 font-mono text-[10px] md:text-xs uppercase tracking-wider px-3 py-1.5 md:px-4 md:py-2"
                        >
                            <span
                                class="w-1.5 h-1.5 md:w-2 md:h-2 bg-amber-600 rounded-full animate-pulse"
                            ></span>
                            {translations.current.badge}
                        </span>
                    </div>

                    <div class="relative">
                        <div class="mb-5 md:mb-6">
                            <h3
                                class="text-2xl md:text-4xl font-bold text-amber-600 mb-2 md:mb-2 leading-tight"
                            >
                                {translations.current.role}
                            </h3>
                            <div
                                class="flex flex-row md:flex-col items-center md:items-start gap-2 md:gap-1"
                            >
                                <span
                                    class="text-base md:text-lg text-zinc-300 font-medium"
                                    >{translations.current.company}</span
                                >
                                <span class="text-zinc-500 md:hidden">•</span>
                                <time
                                    class="font-mono text-xs md:text-sm text-zinc-500"
                                >
                                    {translations.current.date}
                                </time>
                            </div>
                        </div>

                        <ul
                            class="text-base md:text-lg text-zinc-300 space-y-4 md:space-y-3 leading-[1.6]"
                        >
                            {
                                translations.current.bullets.map((bullet) => (
                                    <li class="flex gap-3 md:gap-4 items-start">
                                        <span class="text-amber-600 mt-0.5 flex-shrink-0">
                                            ▸
                                        </span>
                                        <span set:html={bullet} />
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </article>

            <!-- Previous Positions -->
            {
                translations.positions.map((position) => (
                    <article class="observe-fade relative">
                        <div class="border border-zinc-700 bg-zinc-900/30 p-5 md:p-8 hover:border-amber-500/40 hover:bg-zinc-900/50 hover:scale-[1.015] hover:shadow-lg hover:shadow-amber-900/20 transition-all duration-300">
                            <div class="mb-5 md:mb-6">
                                <h3 class="text-xl md:text-2xl font-bold text-white mb-2 leading-tight">
                                    {position.role}
                                </h3>
                                <div class="flex flex-row md:flex-col items-center md:items-start gap-2 md:gap-1">
                                    <span class="text-sm md:text-base text-zinc-300">
                                        {position.company}
                                    </span>
                                    <span class="text-zinc-500 md:hidden">
                                        •
                                    </span>
                                    <time class="font-mono text-xs md:text-sm text-zinc-500">
                                        {position.date}
                                    </time>
                                </div>
                            </div>

                            <ul class="text-sm md:text-base text-zinc-400 space-y-4 md:space-y-3 leading-[1.6]">
                                {position.bullets.map((bullet) => (
                                    <li class="flex gap-3 items-start">
                                        <span class="text-zinc-600 mt-0.5 flex-shrink-0">
                                            ▸
                                        </span>
                                        <span set:html={bullet} />
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>
